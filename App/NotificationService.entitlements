<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group the app keeps the push keys under, so the extension can
	     read them. Must match the app's entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.codes.sand.slopcoder</string>
	</array>
</dict>
</plist>
