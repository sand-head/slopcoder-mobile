{
  "name": "slopcoder (Swift + xtool)",
  // An image and a setup script, nothing else. That is the subset of Dev
  // Containers slopcoder's own sandbox honours (a literal `image` plus the
  // lifecycle hooks; a Dockerfile build, Features, mounts and `remoteUser` are
  // refused), so one file serves an agent session and an editor alike.
  "image": "swift:6.4.2-noble",
  // Installs xtool and the few system packages around it, and the iOS SDK when
  // a copy of Xcode has been left beside the repository. See the script.
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["swiftlang.swift-vscode"],
      "settings": {
        "swift.path": "/usr/bin",
        "files.exclude": { ".build": true, "xtool": true }
      }
    }
  }
}
